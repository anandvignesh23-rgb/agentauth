{
  "version": 2,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/styles.css",
      "destination": "/api/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/api/app.js"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/dashboard",
      "destination": "/api/dashboard"
    },
    {
      "source": "/agents",
      "destination": "/api/agents"
    },
    {
      "source": "/agents/(.*)",
      "destination": "/api/agents/$1"
    },
    {
      "source": "/delegations",
      "destination": "/api/delegations"
    },
    {
      "source": "/delegations/(.*)",
      "destination": "/api/delegations/$1"
    },
    {
      "source": "/requests",
      "destination": "/api/requests"
    },
    {
      "source": "/requests/(.*)",
      "destination": "/api/requests/$1"
    },
    {
      "source": "/step-up",
      "destination": "/api/step-up"
    },
    {
      "source": "/risk",
      "destination": "/api/risk"
    },
    {
      "source": "/security-lab",
      "destination": "/api/security-lab"
    },
    {
      "source": "/audit",
      "destination": "/api/audit"
    },
    {
      "source": "/merchant",
      "destination": "/api/merchant"
    },
    {
      "source": "/developer",
      "destination": "/api/developer"
    },
    {
      "source": "/demo",
      "destination": "/api/demo"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/openapi.json"
    },
    {
      "source": "/docs",
      "destination": "/api/docs"
    },
    {
      "source": "/evidence",
      "destination": "/api/evidence"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
